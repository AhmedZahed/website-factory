{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/App.tsx",
    "src/main.tsx",
    "src/components/error-boundary.tsx",
    "src/components/ui",
    "src/hooks",
    "src/lib/utils.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": [
      "astro/client",
      "@astrojs/cloudflare/types",
      "@cloudflare/workers-types"
    ]
  }
}
