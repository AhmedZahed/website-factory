---
import TemplatePreviewWorkspace from "../../../../components/templates/TemplatePreviewWorkspace";
import { templateCustomizationSchema } from "../../../../lib/templates/config";
import { createDemoCustomization } from "../../../../lib/templates/demo";
import { getTemplateById } from "../../../../lib/templates/registry";
import "../../../../styles/global.css";

const template = getTemplateById(Astro.params.templateId ?? "");
if (!template) Astro.response.status = 404;
const customization = template
  ? templateCustomizationSchema.parse(createDemoCustomization(template))
  : undefined;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content={template?.description.ar ?? "قالب غير موجود"}
    />
    <title>
      {template ? `${template.name.ar} — معاينة داخلية | Website Factory` : "قالب غير موجود | Website Factory"}
    </title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {
      template && customization ? (
        <TemplatePreviewWorkspace
          template={template}
          customization={customization}
          client:load
        />
      ) : (
        <main lang="ar" dir="rtl">
          <h1>القالب غير موجود</h1>
          <a href="/admin/templates">العودة إلى القوالب</a>
        </main>
      )
    }
  </body>
</html>
